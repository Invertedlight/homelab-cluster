  {
    "id": "9a8fede877f9c736",
    "type": "function",
    "z": "e957afae9c5319c9",
    "name": "function 6",
    "func": "var inHG_to_hPa = 33.8638866667;\nvar adjust_sensor = -48 //100.326;\nvar hPA_to_inHG = 0.02952998307;\nvar unit_text = \"inHg\";\nvar pressure = global.get(\"pressure\");\nvar adj_pressure = global.get(\"adj_pressure\");\nvar temperature = global.get(\"temperature\");\nvar humidity = global.get(\"humidity\");\nvar control = {};\nmsg.payload = {}\n\nif (context.global.get(\"Toggle_units\") == true) {\n    pressure = pressure * inHG_to_hPa;\n    adj_pressure = adj_pressure * inHG_to_hPa;\n    unit_text = \"hPa\";\n    control = { \"min\": 800, \"max\": 1200 };   \n}\nelse {\n    pressure = pressure * hPA_to_inHG;\n    adj_pressure = adj_pressure * hPA_to_inHG;\n    unit_text = \"inHg\";\n    control = { \"min\": 25, \"max\": 35};\n}\n\nif (pressure > 1500 || pressure < 10)\n{\n    return;\n}\nelse {\nglobal.set(\"pressure\", pressure);\nglobal.set(\"adj_pressure\", adj_pressure);\nglobal.set(\"ui_control\", control);\n}\nmsg.payload.pressure = pressure.toFixed(2);\nmsg.payload.adj_pressure = adj_pressure.toFixed(2);\nmsg.payload.temperature = temperature;\nmsg.payload.humidity = humidity;\nmsg.ui_control = control;\n\nreturn msg;\n",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
