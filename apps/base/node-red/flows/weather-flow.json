  {
    "id": "433a5c43e967832e",
    "type": "function",
    "z": "e957afae9c5319c9",
    "name": "function 4",
    "func": "\nvar pressure = global.get(\"pressure\");\nvar adj_pressure = global.get(\"adj_pressure\");\nvar temperature = global.get(\"temperature\");\nvar humidity = global.get(\"humidity\");\nvar altitude = global.get(\"alt\");\nvar unit_text = \"hPa\";\nvar ui_control = global.get(\"ui_control\");\nvar msg = msg;\nmsg.payload = {};\n// Normalize adjust hPA to altitude reading, limit decimal places\n//var adj_pressure = pressure + hPa_delta;\n\nif (context.global.get(\"Toggle_units\") == true){\n    unit_text = \"hPa\";\n}\nelse {\n    unit_text = \"inHg\";\n}\n// set msg pressure and adj_pressure\nmsg.payload.pressure = parseFloat(pressure.toFixed(2));\nmsg.payload.adj_pressure = parseFloat(adj_pressure.toFixed(2));\nmsg.payload.temperature = temperature;\nmsg.payload.humidity = humidity;\nmsg.payload.unit_text = unit_text;\nmsg.ui_control = ui_control;\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 800,
