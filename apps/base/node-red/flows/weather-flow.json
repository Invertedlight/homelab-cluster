  {
    "id": "3b65a4ae70602491",
    "type": "function",
    "z": "e957afae9c5319c9",
    "name": "Set Global Weather Vars",
    "func": "\nvar inHG_to_hPa = 33.8638866667;\nvar adjust_sensor = -48 //100.326;\nvar hPA_to_inHG = 0.02952998307;\nvar correction_factor = 32.5 //correction factor to OWM value\nvar pressure = msg.payload.pressure + adjust_sensor;\nvar adj_pressure = 0.0;\nvar temperature = msg.payload.temperature;\nvar humidity = msg.payload.humidity;\nvar altitude = global.get(\"alt\");\nvar unit_text = \"hPa\";\nvar control = { \"min\": 25, \"max\": 35 };\n\n// Calc inHG delta adjustment \n//  .06 inHG for every 50 ft above sea level\nvar inHG_delta = altitude / 50 * .06;\n\n// Normalize hPa reading to sea level reading\nvar hPa_delta = inHG_delta * inHG_to_hPa;\n\n// Normalize adjust hPA to altitude reading, limit decimal places\nadj_pressure = pressure + hPa_delta + correction_factor; //ADD CORRECTION FACTOR\n\nif (context.global.get(\"Toggle_units\") == true) {\n    unit_text = \"hPa\";\n    control = { \"min\": 800, \"max\": 1200 };\n}\nelse {\n    adj_pressure = adj_pressure * hPA_to_inHG ;\n    pressure = (pressure + correction_factor) * hPA_to_inHG\n    unit_text = \"inHg\";\n    control = { \"min\": 25, \"max\": 35 };\n}\n\n// set global pressure and adj_pressure\nglobal.set(\"pressure\", parseFloat(pressure.toFixed(2)));\nglobal.set(\"adj_pressure\", parseFloat(adj_pressure.toFixed(2)))\nglobal.set(\"temperature\", parseFloat(temperature.toFixed(1)));\nglobal.set(\"humidity\", parseFloat(humidity.toFixed(2)));\nglobal.set(\"ui_control\", control);\n\nmsg.payload.pressure = parseFloat(pressure.toFixed(2));\nmsg.payload.adj_pressure = parseFloat(adj_pressure.toFixed(2));\nmsg.payload.temperature = parseFloat(temperature.toFixed(1));\nmsg.payload.humidity = parseFloat(humidity.toFixed(2));\nmsg.ui_control = control;\n\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 250,
    "y": 600,
    "wires": [
