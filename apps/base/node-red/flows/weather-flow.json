  {
    "id": "4a3ad02db8bb7754",
    "type": "function",
    "z": "e957afae9c5319c9",
    "name": "Get Weather Values",
    "func": "var weather = msg.payload;\n\nvar inHG_to_hPa = 33.8638866667;\n//var adjust_sensor = -48 //100.326;\n//var hPA_to_inHG = 0.02952998307;\n\nvar pressure = global.get(\"pressure\");\nvar temperature = global.get(\"temperature\");\nvar humidity = global.get(\"humidity\");\nvar lat = global.get(\"lat\");\nvar lng = global.get(\"lng\");\nvar altitude = global.get(\"alt\");\n\n// Conver to hPA if pressure is in inHg mode.\nif (global.get(\"Toggle_units\") == false) {\n    pressure = pressure * inHG_to_hPa;\n}\n\nmsg.query = \"insert into weatherdata (altitude, pressure, temperature, humidity, lat, lng) values (\" + altitude + \",\" + pressure.toFixed(2)  + \",\" +  temperature + \",\" + humidity + \",\" + lat + \",\" + lng + \");\"\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 270,
    "y": 700,
    "wires": [
