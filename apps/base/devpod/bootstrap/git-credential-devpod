#!/bin/sh
# Git credential helper for github.com. Reads the token from the
# github-credentials Secret at run time. Only answers "get"; never stores.
[ "${1:-}" = "get" ] || exit 0
for f in /run/devpod-github/token /etc/devpod/github/token; do
  if [ -r "$f" ] && [ -s "$f" ]; then
    printf 'username=x-access-token\npassword=%s\n' "$(cat "$f")"
    exit 0
  fi
done
exit 0
