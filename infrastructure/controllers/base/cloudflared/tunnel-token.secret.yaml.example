# Copy to ../../skynet/cloudflared/tunnel-token.secret.yaml, put the real skynet
# tunnel token in stringData.token, then:
#   sops -e -i ../../skynet/cloudflared/tunnel-token.secret.yaml
# The repo-root .sops.yaml age recipient matches clusters/skynet/.sops.yaml.
# Do not put the encrypted file in this directory. vm-staging reuses this base.
apiVersion: v1
kind: Secret
metadata:
  name: cloudflared-tunnel
  namespace: cloudflare
type: Opaque
stringData:
  token: "REPLACE_WITH_SKYNET_TUNNEL_TOKEN"
