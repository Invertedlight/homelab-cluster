# Copy to tunnel-token.secret.yaml, put the real skynet tunnel token in stringData.token,
# then: sops -e -i tunnel-token.secret.yaml
# (uses clusters/staging/.sops.yaml age recipient)
apiVersion: v1
kind: Secret
metadata:
  name: cloudflared-tunnel
  namespace: cloudflare
type: Opaque
stringData:
  token: "REPLACE_WITH_SKYNET_TUNNEL_TOKEN"
