{
  "name": "base:debian with brew and neovim",
  "image": "mcr.microsoft.com/devcontainers/base:debian",
  "features": {},
  "postCreateCommand": "sudo DEBIAN_FRONTEND=noninteractive apt-get update && sudo DEBIAN_FRONTEND=noninteractive apt-get install -y zsh git ca-certificates curl sudo neovim && sudo rm -rf /var/lib/apt/lists/* && /bin/bash -c \"$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\" && sudo chown -R vscode:vscode /home/vscode/.linuxbrew /home/vscode/.cache/Homebrew 2>/dev/null || true && sudo ln -sf /home/vscode/.linuxbrew/bin/brew /usr/local/bin/brew 2>/dev/null || true",
  "settings": {
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.profiles.linux": {
      "zsh": {
        "path": "/usr/bin/zsh"
      }
    }
  }
}
